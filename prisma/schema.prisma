// ─── Multi-Currency & Forex Engine ───────────────────────────────────

model ExchangeRate {
  id            String    @id @default(cuid())
  fromCurrency  String    @default("INR") @map("from_currency") // Base currency (INR)
  toCurrency    String    @unique @map("to_currency") // Target currency (USD, AED, NGN, EUR, etc.)
  rate          Decimal   @db.Decimal(18, 8) // Exchange rate (1 INR = X target)
  inverseRate   Decimal   @map("inverse_rate") @db.Decimal(18, 8) // Inverse rate (1 target = Y INR)
  source        String    @default("AUTO_FEED") // "AUTO_FEED" | "MANUAL_OVERRIDE" | "SYSTEM_DEFAULT"
  isLocked      Boolean   @default(false) @map("is_locked") // If true, auto-fetch won't overwrite
  markupPercent Decimal   @default(0.00) @map("markup_percent") @db.Decimal(5, 2) // Optional spread buffer
  lastFetchedAt DateTime  @default(now()) @map("last_fetched_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

// ─── Legal Proofs & Digital Consent Engine ───────────────────────────

enum LegalConsentType {
  TREATMENT_PLAN_ACCEPTANCE
  MEDICAL_TRAVEL_AGREEMENT
  PHI_DISCLOSURE_AUTHORIZATION
  FINANCIAL_TERMS_AGREEMENT
  VISA_LETTER_REQUEST
  DISCHARGE_ACKNOWLEDGEMENT
}

model LegalConsent {
  id               String           @id @default(cuid())
  verificationCode String           @unique @map("verification_code") // e.g. MR-PROOF-2026-X89K2
  consentType      LegalConsentType @map("consent_type")
  caseId           String?          @map("case_id")
  patientId        String           @map("patient_id")
  entityType       String?          @map("entity_type") // e.g. "TreatmentPlan", "Invoice"
  entityId         String?          @map("entity_id")
  documentHash     String           @map("document_hash") // SHA-256 digest of terms/line items at signing
  signerFullName   String           @map("signer_full_name")
  signerEmail      String           @map("signer_email")
  signerRole       String           @default("PATIENT") @map("signer_role")
  statement        String           @db.Text
  metadata         Json?            // Snapshot of terms/prices agreed
  ipAddress        String?          @map("ip_address")
  userAgent        String?          @map("user_agent")
  geoCountry       String?          @map("geo_country")
  signedAt         DateTime         @default(now()) @map("signed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relations
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  case             Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([caseId])
  @@index([verificationCode])
  @@index([consentType])
  @@index([signedAt])
  @@map("legal_consents")
}

