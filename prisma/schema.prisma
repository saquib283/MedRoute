// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────

enum UserRole {
  PATIENT
  MANAGER
  ADMIN
  DOCTOR
}

enum UrgencyLevel {
  ROUTINE
  SEMI_URGENT
  URGENT
}

enum CaseStatus {
  INQUIRY_RECEIVED
  UNDER_REVIEW
  PRE_OP_CLEARANCE
  PLAN_CONFIRMED
  IN_TREATMENT
  ICU_RECOVERY
  WARD_RECOVERY
  POST_TREATMENT
  OUTPATIENT_RECUPERATION
  FIT_TO_FLY_CLEARED
  REMOTE_REHAB
  CLOSED
}

enum AppointmentType {
  CONSULTATION
  PRE_OP_ASSESSMENT
  SURGERY
  POST_OP_REVIEW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DocumentCategory {
  PASSPORT
  VISA
  VISA_INVITATION_LETTER
  PROFORMA_INVOICE
  MEDICAL_OPINION
  MEDICAL_REPORT
  PRESCRIPTION
  FIT_TO_FLY_CERTIFICATE
  FRRO_REGISTRATION
  INSURANCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}


// ─── Core Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  fullName     String   @map("full_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  totpSecret   String?  @map("totp_secret") // encrypted, for Manager/Admin 2FA
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  patient             Patient?
  managedPatients     Patient[]        @relation("ManagerPatients")
  managedCases        Case[]           @relation("ManagerCases")
  createdAppointments Appointment[]    @relation("CreatedAppointments")
  uploadedDocuments   Document[]       @relation("UploadedDocuments")
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  sentMessages        Message[]        @relation("SentMessages")
  receivedMessages    Message[]        @relation("ReceivedMessages")
  doctorProfile       Doctor?          @relation("DoctorProfile")
  createdBills        MedicalBill[]    @relation("CreatedBills")

  @@map("users")
}

model Patient {
  id                String       @id @default(cuid())
  userId            String       @unique @map("user_id")
  nationality       String
  passportNo        String       @map("passport_no") // encrypted at application level (AES-256)
  dob               DateTime
  bloodGroup        String?      @map("blood_group")
  medicalCondition  String?      @map("medical_condition") @db.Text
  urgencyLevel      UrgencyLevel @default(ROUTINE) @map("urgency_level")
  emergencyContact  Json?        @map("emergency_contact") // { name, phone, relation }
  primaryLanguage   String?      @map("primary_language")
  assignedManagerId String?      @map("assigned_manager_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedManager User?                  @relation("ManagerPatients", fields: [assignedManagerId], references: [id])
  medicalProfile  PatientMedicalProfile?
  cases           Case[]
  appointments    Appointment[]
  documents       Document[]
  medicalBills    MedicalBill[]
  hotelBookings   HotelBooking[]

  @@map("patients")
}

model PatientMedicalProfile {
  id                      String   @id @default(cuid())
  patientId               String   @unique @map("patient_id")
  allergies               Json?    @default("[]") // JSONB array of allergy strings
  medications             Json?    @default("[]") // JSONB array of medication objects
  surgeries               Json?    @default("[]") // JSONB array of surgery records
  chronicConditions       Json?    @default("[]") @map("chronic_conditions")
  specialisationsRequired Json?    @default("[]") @map("specialisations_required")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medical_profiles")
}

model Case {
  id            String     @id @default(cuid())
  patientId     String     @map("patient_id")
  managerId     String?    @map("manager_id")
  status        CaseStatus @default(INQUIRY_RECEIVED)
  notes         String?    @db.Text
  isUrgent      Boolean    @default(false) @map("is_urgent")
  escalationNote String?   @map("escalation_note") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  lastUpdatedAt DateTime   @updatedAt @map("last_updated_at")

  // Relations
  patient            Patient              @relation(fields: [patientId], references: [id])
  manager            User?                @relation("ManagerCases", fields: [managerId], references: [id])
  appointments       Appointment[]
  clinicalSteps      ClinicalStep[]
  fitToFlyClearance  FitToFlyClearance?
  medicalBills       MedicalBill[]
  hotelBookings      HotelBooking[]

  @@index([patientId])
  @@index([managerId])
  @@index([status])
  @@map("cases")
}

model Specialisation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  doctors Doctor[]

  @@map("specialisations")
}

model Hospital {
  id             String   @id @default(cuid())
  name           String
  city           String
  address        String   @db.Text
  accreditation  String?
  contactPerson  String?  @map("contact_person")
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  departments    Json?    @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  doctors             Doctor[]
  appointments        Appointment[]
  commissionOverrides CommissionOverride[]
  medicalBills        MedicalBill[]
  nearHotels          Hotel[]

  @@index([city])
  @@index([isActive])
  @@map("hospitals")
}

model Doctor {
  id               String   @id @default(cuid())
  userId           String?  @unique @map("user_id")
  hospitalId       String   @map("hospital_id")
  fullName         String   @map("full_name")
  specialisationId String   @map("specialisation_id")
  qualification    String?
  languages        Json?    @default("[]")
  consultationFee  Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  availableDays    Json?    @default("[]") @map("available_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user           User?          @relation("DoctorProfile", fields: [userId], references: [id], onDelete: Cascade)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id])
  specialisation Specialisation @relation(fields: [specialisationId], references: [id])
  appointments   Appointment[]

  @@index([hospitalId])
  @@index([specialisationId])
  @@map("doctors")
}


model Appointment {
  id                 String            @id @default(cuid())
  caseId             String            @map("case_id")
  patientId          String            @map("patient_id")
  hospitalId         String            @map("hospital_id")
  doctorId           String            @map("doctor_id")
  appointmentType    AppointmentType   @map("appointment_type")
  scheduledAt        DateTime          @map("scheduled_at")
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?           @map("cancellation_reason")
  clinicalNotes      String?           @map("clinical_notes") @db.Text
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relations
  case     Case     @relation(fields: [caseId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  creator  User     @relation("CreatedAppointments", fields: [createdBy], references: [id])

  @@index([caseId])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}


model Document {
  id                 String           @id @default(cuid())
  patientId          String           @map("patient_id")
  uploadedBy         String           @map("uploaded_by")
  category           DocumentCategory
  fileUrl            String           @map("file_url")
  fileName           String           @map("file_name")
  fileSize           Int              @map("file_size") // bytes
  mimeType           String?          @map("mime_type")
  verificationStatus String           @default("PENDING") @map("verification_status") // PENDING, VERIFIED, REJECTED, ISSUED_BY_HOSPITAL
  verifiedBy         String?          @map("verified_by")
  verificationNotes  String?          @map("verification_notes") @db.Text
  verifiedAt         DateTime?        @map("verified_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  // Relations
  patient  Patient @relation(fields: [patientId], references: [id])
  uploader User    @relation("UploadedDocuments", fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@index([category])
  @@index([verificationStatus])
  @@map("documents")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  channel      NotificationChannel
  title        String
  body         String              @db.Text
  isRead       Boolean             @default(false) @map("is_read")
  sentAt       DateTime            @default(now()) @map("sent_at")
  triggerEvent String?             @map("trigger_event")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  subject    String?
  body       String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("messages")
}

// ─── Email Campaign System ──────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  body        String   @db.Text // HTML body
  category    String   @default("general") // e.g., "marketing", "operational", "onboarding"
  placeholders Json?   @default("[]") // e.g., ["fullName", "email"]
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  campaigns EmailCampaign[]

  @@index([category])
  @@index([isActive])
  @@map("email_templates")
}

model EmailCampaign {
  id           String         @id @default(cuid())
  name         String
  templateId   String         @map("template_id")
  targetRole   String         @map("target_role") // 'ALL' | specific UserRole
  status       CampaignStatus @default(DRAFT)
  sentCount    Int            @default(0) @map("sent_count")
  failedCount  Int            @default(0) @map("failed_count")
  scheduledAt  DateTime?      @map("scheduled_at")
  sentAt       DateTime?      @map("sent_at")
  createdBy    String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  template EmailTemplate @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([templateId])
  @@index([createdAt])
  @@map("email_campaigns")
}

model CommissionOverride {
  id          String   @id @default(cuid())
  hospitalId  String   @map("hospital_id")
  rate        Decimal  @map("rate") @db.Decimal(5, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("commission_overrides")
}

model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model ClinicalStep {
  id             String    @id @default(cuid())
  caseId         String    @map("case_id")
  stageName      String    @default("Stage 1: Pre-Procedure Triage & Medical Clearance") @map("stage_name")
  stageOrder     Int       @default(1) @map("stage_order")
  stepOrder      Int       @default(1) @map("step_order")
  title          String
  category       String    // PRE_OP, TREATMENT, POST_OP, DISCHARGE, REHAB
  status         String    // PENDING, IN_PROGRESS, COMPLETED, ACTION_REQUIRED
  decisionBranch String?   @map("decision_branch") // e.g., FIT_TO_FLY_GRANTED, ICU_ADMISSION, EXTEND_STAY
  doctorNotes    String?   @map("doctor_notes") @db.Text
  actionType     String?   @map("action_type") // e.g., ISSUE_VIL, SIGN_PAC, SIGN_FIT_TO_FLY, UPLOAD_OCR_BILL, VIEW_RECORD
  requiredRole   String?   @map("required_role") // PATIENT, DOCTOR, MANAGER, ADMIN
  actionUrl      String?   @map("action_url")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([category])
  @@map("clinical_steps")
}

model FitToFlyClearance {
  id            String    @id @default(cuid())
  caseId        String    @unique @map("case_id")
  isCleared     Boolean   @default(false) @map("is_cleared")
  clearedBy     String?   @map("cleared_by")
  clearanceDate DateTime? @map("clearance_date")
  restrictions  String?   @db.Text
  reEvalDate    DateTime? @map("re_eval_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("fit_to_fly_clearances")
}

model MedicalBill {
  id          String     @id @default(cuid())
  caseId      String     @map("case_id")
  patientId   String     @map("patient_id")
  hospitalId  String?    @map("hospital_id")
  billNumber  String     @unique @map("bill_number")
  title       String
  category    String     @default("HOSPITAL_SURGERY") // HOSPITAL_SURGERY, PHARMACY, DIAGNOSTICS, CONSULTATION, GENERAL
  totalAmount Decimal    @map("total_amount") @db.Decimal(12, 2)
  paidAmount  Decimal    @default(0) @map("paid_amount") @db.Decimal(12, 2)
  currency    String     @default("USD")
  status      String     @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  dueDate     DateTime?  @map("due_date")
  fileUrl     String?    @map("file_url")
  fileName    String?    @map("file_name")
  notes       String?    @db.Text
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  case      Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id])
  hospital  Hospital?  @relation(fields: [hospitalId], references: [id])
  creator   User       @relation("CreatedBills", fields: [createdBy], references: [id])
  items     BillItem[]

  @@index([caseId])
  @@index([patientId])
  @@index([status])
  @@map("medical_bills")
}

model BillItem {
  id          String      @id @default(cuid())
  billId      String      @map("bill_id")
  description String
  quantity    Int         @default(1)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal     @db.Decimal(12, 2)
  category    String?     // SURGERY_OT, BED_RENT, PHARMACY, DIAGNOSTICS, CONSULTATION, ADMIN_SERVICE

  // Relations
  bill MedicalBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_items")
}

model Hotel {
  id                String         @id @default(cuid())
  name              String
  city              String
  address           String         @db.Text
  nearHospitalId    String?        @map("near_hospital_id")
  distanceKm        Float          @default(2.5) @map("distance_km")
  starRating        Float          @default(4.5) @map("star_rating")
  nightlyRateUsd    Decimal        @map("nightly_rate_usd") @db.Decimal(10, 2)
  commissionPercent Decimal        @default(15.0) @map("commission_percent") @db.Decimal(5, 2)
  amenities         Json?          // Array of amenity strings e.g. ["Wheelchair Accessible", "Halal Food", "ICU Nurse On-Call"]
  images            Json?          // Array of image URLs
  description       String?        @db.Text
  contactPhone      String?        @map("contact_phone")
  contactEmail      String?        @map("contact_email")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  nearHospital Hospital?      @relation(fields: [nearHospitalId], references: [id])
  bookings     HotelBooking[]

  @@index([nearHospitalId])
  @@index([city])
  @@map("hotels")
}

model HotelBooking {
  id                  String   @id @default(cuid())
  bookingNo           String   @unique @map("booking_no")
  patientId           String   @map("patient_id")
  hotelId             String   @map("hotel_id")
  caseId              String?  @map("case_id")
  checkInDate         DateTime @map("check_in_date")
  checkOutDate        DateTime @map("check_out_date")
  roomType            String   @default("Deluxe Recovery Suite") @map("room_type")
  numGuests           Int      @default(2) @map("num_guests")
  numNights           Int      @default(3) @map("num_nights")
  totalAmountUsd      Decimal  @map("total_amount_usd") @db.Decimal(10, 2)
  commissionAmountUsd Decimal  @map("commission_amount_usd") @db.Decimal(10, 2)
  status              String   @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, COMPLETED, CANCELLED
  specialRequests     String?  @map("special_requests") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  case    Case?   @relation(fields: [caseId], references: [id])

  @@index([patientId])
  @@index([hotelId])
  @@index([caseId])
  @@map("hotel_bookings")
}



