  storageKey  String?    @map("storage_key")
  fileName    String?    @map("file_name")
  notes       String?    @db.Text
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  case      Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id])
  hospital  Hospital?  @relation(fields: [hospitalId], references: [id])
  creator   User       @relation("CreatedBills", fields: [createdBy], references: [id])
  items     BillItem[]

  @@index([caseId])
  @@index([patientId])
  @@index([status])
  @@map("medical_bills")
}

model BillItem {
  id          String      @id @default(cuid())
  billId      String      @map("bill_id")
  description String
  quantity    Int         @default(1)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal     @db.Decimal(12, 2)
  category    String?     // SURGERY_OT, BED_RENT, PHARMACY, DIAGNOSTICS, CONSULTATION, ADMIN_SERVICE

  // Relations
  bill MedicalBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_items")
}

model Hotel {
  id                String         @id @default(cuid())
  name              String
  city              String
  address           String         @db.Text
  nearHospitalId    String?        @map("near_hospital_id")
  distanceKm        Float          @default(2.5) @map("distance_km")
  starRating        Float          @default(4.5) @map("star_rating")
  nightlyRateUsd    Decimal        @map("nightly_rate_usd") @db.Decimal(10, 2)
  commissionPercent Decimal        @default(15.0) @map("commission_percent") @db.Decimal(5, 2)
  amenities         Json?          // Array of amenity strings e.g. ["Wheelchair Accessible", "Halal Food", "ICU Nurse On-Call"]
  images            Json?          // Array of image URLs
  description       String?        @db.Text
  contactPhone      String?        @map("contact_phone")
  contactEmail      String?        @map("contact_email")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  nearHospital Hospital?      @relation(fields: [nearHospitalId], references: [id])
  bookings     HotelBooking[]

  @@index([nearHospitalId])
  @@index([city])
  @@map("hotels")
}

model HotelBooking {
  id                  String   @id @default(cuid())
  bookingNo           String   @unique @map("booking_no")
  patientId           String   @map("patient_id")
  hotelId             String   @map("hotel_id")
  caseId              String?  @map("case_id")
  checkInDate         DateTime @map("check_in_date")
  checkOutDate        DateTime @map("check_out_date")
  roomType            String   @default("Deluxe Recovery Suite") @map("room_type")
  numGuests           Int      @default(2) @map("num_guests")
  numNights           Int      @default(3) @map("num_nights")
  totalAmountUsd      Decimal  @map("total_amount_usd") @db.Decimal(10, 2)
  commissionAmountUsd Decimal  @map("commission_amount_usd") @db.Decimal(10, 2)
  status              String   @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, COMPLETED, CANCELLED
  specialRequests     String?  @map("special_requests") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  case    Case?   @relation(fields: [caseId], references: [id])

  @@index([patientId])
  @@index([hotelId])
  @@index([caseId])
  @@map("hotel_bookings")
}

// ─── Hospital IPS Portal & Clinical Quotation Engine ───────────────────

enum HospitalQuoteStatus {
  SUBMITTED
  ACCEPTED_BY_PATIENT
  REJECTED
  EXPIRED
}

model HospitalQuote {
  id                String              @id @default(cuid())
  caseId            String              @map("case_id")
  hospitalId        String              @map("hospital_id")
  doctorId          String?             @map("doctor_id")
  title             String
  description       String              @db.Text
  estimatedStayDays Int                 @map("estimated_stay_days")
  icuDays           Int                 @default(0) @map("icu_days")
  roomCategory      String              @default("DELUXE_SINGLE") @map("room_category")
  estimatedCost     Decimal             @map("estimated_cost") @db.Decimal(12, 2)
  currency          String              @default("INR")
  inclusions        Json?               @default("[]") // string[]
  exclusions        Json?               @default("[]") // string[]
  status            HospitalQuoteStatus @default(SUBMITTED)
  validUntil        DateTime?           @map("valid_until")
  submittedBy       String?             @map("submitted_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  case              Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hospital          Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor            Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([hospitalId])
  @@index([doctorId])
  @@index([status])
  @@map("hospital_quotes")
}

// ─── Automated Commission Engine & Partner Settlements ─────────────────

enum CommissionCategory {
  HOSPITAL_SURGICAL
  HOTEL_ACCOMMODATION
  LOGISTICS_TRANSFER
  FACILITATION_FEE
  AFFILIATE_BROKER
}

enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSED
  DISPUTED
}

model CommissionRule {
  id          String             @id @default(cuid())
  ruleName    String             @map("rule_name")
  category    CommissionCategory
  partnerId   String?            @map("partner_id") // null = global default, or specific hospitalId / hostelId
  partnerName String?            @map("partner_name")
  ratePercent Decimal            @map("rate_percent") @db.Decimal(5, 2)
  flatFee     Decimal?           @map("flat_fee") @db.Decimal(10, 2)
  minFee      Decimal?           @map("min_fee") @db.Decimal(10, 2)
  maxFee      Decimal?           @map("max_fee") @db.Decimal(10, 2)
  currency    String             @default("INR")
  startDate   DateTime?          @map("start_date")
  endDate     DateTime?          @map("end_date")
  isActive    Boolean            @default(true) @map("is_active")
  notes       String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([category])
  @@index([partnerId])
  @@index([isActive])
  @@map("commission_rules")
}

model PartnerSettlement {
  id               String           @id @default(cuid())
  settlementNumber String           @unique @map("settlement_number") // MR-SET-2026-0001
  partnerType      String           @map("partner_type") // HOSPITAL, HOTEL, LOGISTICS
  partnerId        String           @map("partner_id")
  partnerName      String           @map("partner_name")
  invoiceId        String           @map("invoice_id")
  grossAmount      Decimal          @map("gross_amount") @db.Decimal(12, 2)
  commissionRate   Decimal          @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(12, 2)
  netPayable       Decimal          @map("net_payable") @db.Decimal(12, 2)
  currency         String           @default("INR")
  status           SettlementStatus @default(PENDING)
  paymentReference String?          @map("payment_reference") // Bank wire UTR / Cheque No
  paidAt           DateTime?        @map("paid_at")
  processedBy      String?          @map("processed_by")
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([invoiceId])
  @@index([status])
  @@index([partnerType])
  @@map("partner_settlements")
}

// ─── Advanced Leads CRM & B2B Referral Partners ─────────────────────

model ReferralPartner {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  partnerType       String   @map("partner_type")
  country           String
  contactName       String?  @map("contact_name")
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone")
  commissionPercent Decimal  @default(10.00) @map("commission_percent") @db.Decimal(5, 2)
  isActive          Boolean  @default(true) @map("is_active")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  leads Lead[]
  cases Case[]

  @@index([partnerType])
  @@index([isActive])
  @@index([country])
  @@map("referral_partners")
}

model Lead {
  id                    String          @id @default(cuid())
  referenceNo           String          @unique @map("reference_no")
  fullName              String          @map("full_name")
  email                 String?
  phone                 String?
  whatsappNumber        String?         @map("whatsapp_number")
  nationality           String
  countryOfResidence    String?         @map("country_of_residence")
  preferredLanguage     String?         @map("preferred_language")
  medicalCondition      String          @map("medical_condition") @db.Text
  specialtyInterest     String?         @map("specialty_interest")
  urgencyLevel          UrgencyLevel    @default(ROUTINE) @map("urgency_level")
  hasDiagnosticReports  Boolean         @default(false) @map("has_diagnostic_reports")
  passportReady         Boolean         @default(false) @map("passport_ready")
  preferredTravelWindow String?         @map("preferred_travel_window")
  estimatedBudgetUsd    Decimal?        @map("estimated_budget_usd") @db.Decimal(12, 2)
  preliminaryQuoteUsd   Decimal?        @map("preliminary_quote_usd") @db.Decimal(12, 2)
  preliminaryQuoteNotes String?         @map("preliminary_quote_notes") @db.Text
  targetHospitalId      String?         @map("target_hospital_id")
  targetDoctorId        String?         @map("target_doctor_id")
  status                LeadStatus      @default(NEW)
  source                LeadSource      @default(WEBSITE_INQUIRY)
  leadScore             Int             @default(0) @map("lead_score")
  temperature           LeadTemperature @default(WARM)
  assignedManagerId     String?         @map("assigned_manager_id")
  referralPartnerId     String?         @map("referral_partner_id")
  utmSource             String?         @map("utm_source")
  utmMedium             String?         @map("utm_medium")
  utmCampaign           String?         @map("utm_campaign")
  firstResponseDueAt    DateTime        @map("first_response_due_at")
  firstRespondedAt      DateTime?       @map("first_responded_at")
  lastContactedAt       DateTime?       @map("last_contacted_at")
  nextFollowUpAt        DateTime?       @map("next_follow_up_at")
  lostReason            String?         @map("lost_reason")
  lostNotes             String?         @map("lost_notes") @db.Text
  convertedPatientId    String?         @map("converted_patient_id")
  convertedCaseId       String?         @unique @map("converted_case_id")
  convertedAt           DateTime?       @map("converted_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  assignedManager User?            @relation("ManagerLeads", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  referralPartner ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  activities      LeadActivity[]

  @@index([status])
  @@index([assignedManagerId])
  @@index([source])
  @@index([temperature, leadScore])
  @@index([firstResponseDueAt])
  @@index([nextFollowUpAt])
  @@index([email])
  @@index([phone])
  @@index([referralPartnerId])
  @@map("leads")
}

model LeadActivity {
  id           String           @id @default(cuid())
  leadId       String           @map("lead_id")
  actorId      String?          @map("actor_id")
  activityType LeadActivityType @map("activity_type")
  summary      String
  details      Json?
  dueAt        DateTime?        @map("due_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  // Relations
  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([dueAt])
  @@map("lead_activities")
}
