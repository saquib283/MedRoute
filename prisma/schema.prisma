// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────

enum UserRole {
  PATIENT
  MANAGER
  ADMIN
  DOCTOR
  HOSPITAL
}

enum UrgencyLevel {
  ROUTINE
  SEMI_URGENT
  URGENT
}

enum CaseStatus {
  INQUIRY_RECEIVED
  UNDER_REVIEW
  PRE_OP_CLEARANCE
  PLAN_CONFIRMED
  IN_TREATMENT
  ICU_RECOVERY
  WARD_RECOVERY
  POST_TREATMENT
  OUTPATIENT_RECUPERATION
  FIT_TO_FLY_CLEARED
  REMOTE_REHAB
  CLOSED
}

enum AppointmentType {
  CONSULTATION
  PRE_OP_ASSESSMENT
  SURGERY
  POST_OP_REVIEW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AppointmentMode {
  TELECONSULTATION
  IN_PERSON
}

enum DocumentCategory {
  PASSPORT
  VISA
  VISA_INVITATION_LETTER
  PROFORMA_INVOICE
  MEDICAL_OPINION
  MEDICAL_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  TREATMENT_PLAN
  INVOICE
  VISA_LETTER
  FIT_TO_FLY_CERTIFICATE
  FRRO_REGISTRATION
  INSURANCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum LeadStatus {
  NEW
  CONTACTED
  MEDICAL_RECORDS_REQUESTED
  CLINICAL_REVIEW
  QUOTE_SHARED
  NURTURING
  QUALIFIED
  CONVERTED
  LOST
  CLOSED
}

enum LeadSource {
  WEBSITE_INQUIRY
  WHATSAPP
  PHONE_CALL
  B2B_PARTNER
  DOCTOR_REFERRAL
  EMBASSY_SPONSOR
  META_GOOGLE_ADS
  EMAIL_CAMPAIGN
  WALK_IN
}

enum AccommodationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  DORMITORY
}

enum TreatmentPlanStatus {
  DRAFT
  SENT_TO_PATIENT
  ACCEPTED
  REJECTED
  REVISED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  TREATMENT
  ACCOMMODATION
  LOGISTICS
  FACILITATION_FEE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  INTERNATIONAL_WIRE
}

enum TransferType {
  AIRPORT_PICKUP
  AIRPORT_DROP
  HOSPITAL_TRANSFER
  HOTEL_TRANSFER
}

enum TransferStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisaLetterStatus {
  REQUESTED
  GENERATED
  SENT
  EXPIRED
}

enum FollowUpType {
  IN_PERSON
  VIDEO_CALL
  PHONE_CALL
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum PartnerType {
  HOTEL
  HOSTEL
  GUEST_HOUSE
  SERVICED_APARTMENT
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum LeadActivityType {
  NOTE
  WHATSAPP
  PHONE_CALL
  EMAIL
  QUOTE_ESTIMATE
  STATUS_CHANGE
  FOLLOW_UP_SCHEDULED
  CONVERSION
}

// ─── Core Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  fullName     String   @map("full_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  totpSecret   String?  @map("totp_secret") // encrypted, for Manager/Admin 2FA
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  hospitalId   String?  @map("hospital_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  patient             Patient?
  managedPatients     Patient[]        @relation("ManagerPatients")
  managedCases        Case[]           @relation("ManagerCases")
  createdAppointments Appointment[]    @relation("CreatedAppointments")
  uploadedDocuments   Document[]       @relation("UploadedDocuments")
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  sentMessages        Message[]        @relation("SentMessages")
  receivedMessages    Message[]        @relation("ReceivedMessages")
  doctorProfile       Doctor?          @relation("DoctorProfile")
  hospital            Hospital?        @relation("HospitalStaff", fields: [hospitalId], references: [id])
  createdBills        MedicalBill[]    @relation("CreatedBills")
  managedLeads        Lead[]           @relation("ManagerLeads")
  leadActivities      LeadActivity[]   @relation("LeadActivityActor")

  @@map("users")
}

model Patient {
  id                String       @id @default(cuid())
  userId            String       @unique @map("user_id")
  nationality       String
  passportNo        String       @map("passport_no") // encrypted at application level (AES-256)
  passportExpiry    DateTime?    @map("passport_expiry")
  dob               DateTime
  bloodGroup        String?      @map("blood_group")
  medicalCondition  String?      @map("medical_condition") @db.Text
  urgencyLevel      UrgencyLevel @default(ROUTINE) @map("urgency_level")
  emergencyContact  Json?        @map("emergency_contact") // { name, phone, relation }
  primaryLanguage   String?      @map("primary_language")
  preferredCurrency String?      @default("USD") @map("preferred_currency")
  countryCode       String?      @map("country_code")
  assignedManagerId String?      @map("assigned_manager_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedManager User?                  @relation("ManagerPatients", fields: [assignedManagerId], references: [id])
  medicalProfile  PatientMedicalProfile?
  cases           Case[]
  appointments          Appointment[]
  documents             Document[]
  legalConsents         LegalConsent[]
  formCRegistrations    FormCRegistration[]
  transplantCompliances TransplantCompliance[]
  grievanceRecords      GrievanceRecord[]
  medicalBills          MedicalBill[]
  hotelBookings         HotelBooking[]

  @@map("patients")
}

model PatientMedicalProfile {
  id                      String   @id @default(cuid())
  patientId               String   @unique @map("patient_id")
  allergies               Json?    @default("[]") // JSONB array of allergy strings
  medications             Json?    @default("[]") // JSONB array of medication objects
  surgeries               Json?    @default("[]") // JSONB array of surgery records
  chronicConditions       Json?    @default("[]") @map("chronic_conditions")
  specialisationsRequired Json?    @default("[]") @map("specialisations_required")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medical_profiles")
}

model Case {
  id                  String     @id @default(cuid())
  patientId           String     @map("patient_id")
  managerId           String?    @map("manager_id")
  hospitalId          String?    @map("hospital_id")
  primaryDoctorId     String?    @map("primary_doctor_id")
  referralPartnerId   String?    @map("referral_partner_id")
  status              CaseStatus @default(INQUIRY_RECEIVED)
  notes               String?    @db.Text
  isUrgent            Boolean    @default(false) @map("is_urgent")
  escalationNote      String?    @map("escalation_note") @db.Text
  // Journey tracking & financials
  arrivalDate         DateTime?  @map("arrival_date")
  departureDate       DateTime?  @map("departure_date")
  totalEstimatedCost  Decimal?   @map("total_estimated_cost") @db.Decimal(12, 2)
  totalBilledAmount   Decimal?   @map("total_billed_amount") @db.Decimal(12, 2)
  totalPaidAmount     Decimal?   @map("total_paid_amount") @db.Decimal(12, 2)
  treatmentPlan       Json?      @map("treatment_plan")
  travelLogistics     Json?      @map("travel_logistics")
  postReturnFollowUps Json?      @map("post_return_follow_ups")
  createdAt           DateTime   @default(now()) @map("created_at")
  lastUpdatedAt       DateTime   @updatedAt @map("last_updated_at")

  // Relations
  patient               Patient                @relation(fields: [patientId], references: [id])
  manager               User?                  @relation("ManagerCases", fields: [managerId], references: [id])
  hospital              Hospital?              @relation(fields: [hospitalId], references: [id])
  primaryDoctor         Doctor?                @relation("PrimaryDoctorCases", fields: [primaryDoctorId], references: [id])
  referralPartner       ReferralPartner?       @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  accommodationBookings AccommodationBooking[]
  treatmentPlans        TreatmentPlan[]
  invoices              Invoice[]
  visaAssistances       VisaAssistance[]
  transferBookings      TransferBooking[]
  dischargeSummaries    DischargeSummary[]
  followUps             FollowUp[]
  legalConsents         LegalConsent[]
  formCRegistrations    FormCRegistration[]
  transplantCompliance  TransplantCompliance?
  grievanceRecords      GrievanceRecord[]
  hospitalQuotes        HospitalQuote[]
  clinicalSteps         ClinicalStep[]
  fitToFlyClearance     FitToFlyClearance?
  medicalBills          MedicalBill[]
  hotelBookings         HotelBooking[]

  @@index([patientId])
  @@index([managerId])
  @@index([hospitalId])
  @@index([primaryDoctorId])
  @@index([referralPartnerId])
  @@index([status])
  @@map("cases")
}

model Specialisation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  doctors Doctor[]

  @@map("specialisations")
}

model Hospital {
  id                String   @id @default(cuid())
  name              String
  city              String
  address           String   @db.Text
  accreditation     String?
  contactPerson     String?  @map("contact_person")
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone")
  commissionRate    Decimal? @map("commission_rate") @db.Decimal(5, 2)
  isActive          Boolean  @default(true) @map("is_active")
  departments       Json?    @default("[]")
  bankDetails       Json?    @map("bank_details") // { bankName, accountNo, ifsc, beneficiary }
  contractStartDate DateTime? @map("contract_start_date")
  contractEndDate   DateTime? @map("contract_end_date")
  specialPackages   Json?    @default("[]") @map("special_packages") // [{ name, description, price, inclusions }]
  websiteUrl        String?  @map("website_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  cases               Case[]
  doctors             Doctor[]
  appointments        Appointment[]
  commissionOverrides CommissionOverride[]
  treatmentPlanItems  TreatmentPlanItem[]
  invoices            Invoice[]
  visaAssistances     VisaAssistance[]
  coordinators        User[]                @relation("HospitalStaff")
  hospitalQuotes      HospitalQuote[]
  medicalBills        MedicalBill[]
  nearHotels          Hotel[]

  @@index([city])
  @@index([isActive])
  @@map("hospitals")
}

model Doctor {
  id               String   @id @default(cuid())
  userId           String?  @unique @map("user_id")
  hospitalId       String   @map("hospital_id")
  fullName         String   @map("full_name")
  specialisationId String   @map("specialisation_id")
  qualification    String?
  languages        Json?    @default("[]")
  consultationFee  Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  availableDays    Json?    @default("[]") @map("available_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user               User?               @relation("DoctorProfile", fields: [userId], references: [id], onDelete: Cascade)
  hospital           Hospital            @relation(fields: [hospitalId], references: [id])
  specialisation     Specialisation      @relation(fields: [specialisationId], references: [id])
  appointments       Appointment[]
  primaryCases       Case[]              @relation("PrimaryDoctorCases")
  treatmentPlanItems TreatmentPlanItem[]
  dischargeSummaries DischargeSummary[]
  followUps          FollowUp[]
  hospitalQuotes     HospitalQuote[]

  @@index([hospitalId])
  @@index([specialisationId])
  @@map("doctors")
}

model Hostel {
  id                 String      @id @default(cuid())
  name               String
  city               String
  address            String      @db.Text
  description        String?     @db.Text
  partnerType        PartnerType @default(HOSTEL) @map("partner_type")
  capacity           Int
  pricingPerNight    Decimal     @map("pricing_per_night") @db.Decimal(10, 2)
  commissionRate     Decimal?    @map("commission_rate") @db.Decimal(5, 2) // MediRoute's cut from this partner
  roomTypes          Json?       @default("[]") @map("room_types")
  amenities          Json?       @default("[]")
  images             Json?       @default("[]")
  distanceToHospital String?     @map("distance_to_hospital")
  nearestHospital    String?     @map("nearest_hospital") // name of nearest partner hospital
  rating             Decimal?    @default(4.8) @db.Decimal(3, 1)
  contactPhone       String?     @map("contact_phone")
  contactEmail       String?     @map("contact_email")
  contactPerson      String?     @map("contact_person")
  bankDetails        Json?       @map("bank_details") // { bankName, accountNo, ifsc, beneficiary }
  contractActive     Boolean     @default(true) @map("contract_active")
  rules              String?     @db.Text
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Relations
  accommodationBookings AccommodationBooking[]

  @@index([city])
  @@index([partnerType])
  @@map("hostels")
}

model Appointment {
  id                 String            @id @default(cuid())
  caseId             String            @map("case_id")
  patientId          String            @map("patient_id")
  hospitalId         String            @map("hospital_id")
  doctorId           String            @map("doctor_id")
  appointmentType     AppointmentType   @map("appointment_type")
  mode                AppointmentMode   @default(IN_PERSON)
  meetingUrl          String?           @map("meeting_url") @db.VarChar(500)
  interpreterLanguage String?           @map("interpreter_language") @db.VarChar(100)
  scheduledAt         DateTime          @map("scheduled_at")
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?           @map("cancellation_reason")
  clinicalNotes      String?           @map("clinical_notes") @db.Text
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relations
  case     Case     @relation(fields: [caseId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  creator  User     @relation("CreatedAppointments", fields: [createdBy], references: [id])

  @@index([caseId])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model AccommodationBooking {
  id               String              @id @default(cuid())
  caseId           String              @map("case_id")
  hostelId         String              @map("hostel_id")
  checkIn          DateTime            @map("check_in")
  checkOut         DateTime            @map("check_out")
  roomType         RoomType            @map("room_type")
  status           AccommodationStatus @default(PENDING)
  nightlyRate      Decimal?            @map("nightly_rate") @db.Decimal(10, 2)
  totalNights      Int?                @map("total_nights")
  totalAmount      Decimal?            @map("total_amount") @db.Decimal(12, 2)
  commissionRate   Decimal?            @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal?            @map("commission_amount") @db.Decimal(12, 2)
  guestNotes       String?             @map("guest_notes") @db.Text
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  // Relations
  case               Case                @relation(fields: [caseId], references: [id])
  hostel             Hostel              @relation(fields: [hostelId], references: [id])
  formCRegistrations FormCRegistration[]

  @@index([caseId])
  @@index([hostelId])
  @@map("accommodation_bookings")
}

model Document {
  id                 String           @id @default(cuid())
  patientId          String           @map("patient_id")
  uploadedBy         String           @map("uploaded_by")
  category           DocumentCategory
  fileUrl            String           @map("file_url")
  storageKey         String?          @map("storage_key")
  fileName           String           @map("file_name")
  fileSize           Int              @map("file_size") // bytes
  mimeType           String?          @map("mime_type")
  sha256Hash         String?          @map("sha256_hash") // Cryptographic file integrity hash
  verificationStatus String           @default("PENDING") @map("verification_status") // PENDING, VERIFIED, REJECTED, ISSUED_BY_HOSPITAL
  verifiedBy         String?          @map("verified_by")
  verificationNotes  String?          @map("verification_notes") @db.Text
  verifiedAt         DateTime?        @map("verified_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  // Relations
  patient  Patient @relation(fields: [patientId], references: [id])
  uploader User    @relation("UploadedDocuments", fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@index([category])
  @@index([verificationStatus])
  @@map("documents")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  channel      NotificationChannel
  title        String
  body         String              @db.Text
  isRead       Boolean             @default(false) @map("is_read")
  sentAt       DateTime            @default(now()) @map("sent_at")
  triggerEvent String?             @map("trigger_event")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String   @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  requestMethod String?  @map("request_method")
  route         String?
  status        String?  @default("SUCCESS")
  // Cryptographic Hash Chaining for Tamper Evidence
  hash          String?  // SHA-256(id + actorId + action + entityId + timestamp + payload + previousHash)
  previousHash  String?  @map("previous_hash") // SHA-256 of preceding log
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([hash])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  otpHash   String    @map("otp_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  subject    String?
  body       String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("messages")
}

// ─── Email Campaign System ──────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  body        String   @db.Text // HTML body
  category    String   @default("general") // e.g., "marketing", "operational", "onboarding"
  placeholders Json?   @default("[]") // e.g., ["fullName", "email"]
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  campaigns EmailCampaign[]

  @@index([category])
  @@index([isActive])
  @@map("email_templates")
}

model EmailCampaign {
  id           String         @id @default(cuid())
  name         String
  templateId   String         @map("template_id")
  targetRole   String         @map("target_role") // 'ALL' | specific UserRole
  status       CampaignStatus @default(DRAFT)
  sentCount    Int            @default(0) @map("sent_count")
  failedCount  Int            @default(0) @map("failed_count")
  scheduledAt  DateTime?      @map("scheduled_at")
  sentAt       DateTime?      @map("sent_at")
  createdBy    String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  template EmailTemplate @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([templateId])
  @@index([createdAt])
  @@map("email_campaigns")
}

model CommissionOverride {
  id          String   @id @default(cuid())
  hospitalId  String   @map("hospital_id")
  rate        Decimal  @map("rate") @db.Decimal(5, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("commission_overrides")
}

// ─── Lead Query System (External Marketing Campaigns) ───────────

model LeadQuery {
  id                  String     @id @default(cuid())
  fullName            String     @map("full_name")
  email               String
  phone               String
  nationality         String
  city                String?
  medicalCondition    String     @map("medical_condition") @db.Text
  preferredHospitalCity String?  @map("preferred_hospital_city")
  estimatedBudget     String?    @map("estimated_budget")
  source              String     @default("website") // e.g., "google_ads", "facebook", "referral", "website"
  message             String?    @db.Text
  status              LeadStatus @default(NEW)
  adminNotes          String?    @map("admin_notes") @db.Text
  convertedUserId     String?    @map("converted_user_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([source])
  @@index([email])
  @@index([createdAt])
  @@map("lead_queries")
}

model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ─── Treatment Plan & Cost Estimate System ──────────────────────────

model TreatmentPlan {
  id                String              @id @default(cuid())
  caseId            String              @map("case_id")
  title             String              // e.g., "Cardiac Bypass Surgery Plan"
  description       String?             @db.Text
  status            TreatmentPlanStatus @default(DRAFT)
  totalEstimatedCost Decimal?           @map("total_estimated_cost") @db.Decimal(12, 2)
  estimatedDuration  String?            @map("estimated_duration") // e.g., "7-10 days"
  estimatedHospitalStay String?         @map("estimated_hospital_stay") // e.g., "5 nights"
  estimatedRecovery  String?            @map("estimated_recovery") // e.g., "2-3 weeks"
  patientNotes      String?             @map("patient_notes") @db.Text // Patient's response/notes on acceptance/rejection
  sentAt            DateTime?           @map("sent_at")
  respondedAt       DateTime?           @map("responded_at")
  createdBy         String              @map("created_by") // Manager who created
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

