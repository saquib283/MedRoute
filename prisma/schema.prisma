// ─── NABH Patient Grievance Redressal Mechanism ──────────────────────

enum GrievanceCategory {
  CLINICAL_COORDINATION
  BILLING_TRANSPARENCY
  ACCOMMODATION_TRANSPORT
  STAFF_CONDUCT
  PRIVACY_DATA
  VISA_DELAYS
}

enum GrievanceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GrievanceStatus {
  SUBMITTED
  UNDER_INVESTIGATION
  RESOLVED
  ESCALATED_TO_NABH
}

model GrievanceRecord {
  id                     String            @id @default(cuid())
  ticketNumber           String            @unique @map("ticket_number") // e.g. MR-GRV-2026-0042
  patientId              String            @map("patient_id")
  caseId                 String?           @map("case_id")
  category               GrievanceCategory
  severity               GrievanceSeverity @default(MEDIUM)
  subject                String
  description            String            @db.Text
  status                 GrievanceStatus   @default(SUBMITTED)
  acknowledgedAt         DateTime?         @map("acknowledged_at")
  acknowledgedBy         String?           @map("acknowledged_by")
  resolutionNotes        String?           @map("resolution_notes") @db.Text
  resolvedAt             DateTime?         @map("resolved_at")
  resolvedBy             String?           @map("resolved_by")
  slaAcknowledgeDeadline DateTime          @map("sla_ack_deadline") // created + 48 hours (NABH statutory SLA)
  slaResolutionDeadline  DateTime          @map("sla_res_deadline") // created + 7 days (NABH statutory SLA)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  // Relations
  patient                Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  case                   Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([caseId])
  @@index([status])
  @@index([ticketNumber])
  @@map("grievance_records")
}

// ─── FEMA & Inward Foreign Remittance Compliance ─────────────────────

model FemaRemittance {
  id                  String   @id @default(cuid())
  invoiceId           String   @map("invoice_id")
  fircNumber          String?  @map("firc_number") // Foreign Inward Remittance Certificate Number
