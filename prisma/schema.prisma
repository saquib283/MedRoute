// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────

enum UserRole {
  PATIENT
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UrgencyLevel {
  ROUTINE
  SEMI_URGENT
  URGENT
}

enum CaseStatus {
  INQUIRY_RECEIVED
  UNDER_REVIEW
  PLAN_CONFIRMED
  IN_TREATMENT
  POST_TREATMENT
  CLOSED
}

enum AppointmentType {
  CONSULTATION
  PRE_OP_ASSESSMENT
  SURGERY
  POST_OP_REVIEW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DocumentCategory {
  PASSPORT
  MEDICAL_REPORT
  INSURANCE
  VISA
  PRESCRIPTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum AccommodationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  DORMITORY
}

// ─── Core Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  fullName     String   @map("full_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  totpSecret   String?  @map("totp_secret") // encrypted, for Manager/Admin 2FA
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  patient             Patient?
  managedPatients     Patient[]        @relation("ManagerPatients")
  managedCases        Case[]           @relation("ManagerCases")
  createdAppointments Appointment[]    @relation("CreatedAppointments")
  uploadedDocuments   Document[]       @relation("UploadedDocuments")
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  sentMessages        Message[]        @relation("SentMessages")
  receivedMessages    Message[]        @relation("ReceivedMessages")

  @@map("users")
}

model Patient {
  id                String       @id @default(cuid())
  userId            String       @unique @map("user_id")
  nationality       String
  passportNo        String       @map("passport_no") // encrypted at application level (AES-256)
  dob               DateTime
  bloodGroup        String?      @map("blood_group")
  medicalCondition  String?      @map("medical_condition") @db.Text
  urgencyLevel      UrgencyLevel @default(ROUTINE) @map("urgency_level")
  emergencyContact  Json?        @map("emergency_contact") // { name, phone, relation }
  primaryLanguage   String?      @map("primary_language")
  assignedManagerId String?      @map("assigned_manager_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedManager User?                  @relation("ManagerPatients", fields: [assignedManagerId], references: [id])
  medicalProfile  PatientMedicalProfile?
  cases           Case[]
  appointments    Appointment[]
  documents       Document[]

  @@map("patients")
}

model PatientMedicalProfile {
  id                      String   @id @default(cuid())
  patientId               String   @unique @map("patient_id")
  allergies               Json?    @default("[]") // JSONB array of allergy strings
  medications             Json?    @default("[]") // JSONB array of medication objects
  surgeries               Json?    @default("[]") // JSONB array of surgery records
  chronicConditions       Json?    @default("[]") @map("chronic_conditions")
  specialisationsRequired String[] @map("specialisations_required") // Postgres ARRAY
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medical_profiles")
}

model Case {
  id            String     @id @default(cuid())
  patientId     String     @map("patient_id")
  managerId     String?    @map("manager_id")
  status        CaseStatus @default(INQUIRY_RECEIVED)
  notes         String?    @db.Text
  isUrgent      Boolean    @default(false) @map("is_urgent")
  escalationNote String?   @map("escalation_note") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  lastUpdatedAt DateTime   @updatedAt @map("last_updated_at")

  // Relations
  patient               Patient                @relation(fields: [patientId], references: [id])
  manager               User?                  @relation("ManagerCases", fields: [managerId], references: [id])
  appointments          Appointment[]
  accommodationBookings AccommodationBooking[]

  @@index([patientId])
  @@index([managerId])
  @@index([status])
  @@map("cases")
}

model Specialisation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  doctors Doctor[]

  @@map("specialisations")
}

model Hospital {
  id             String   @id @default(cuid())
  name           String
  city           String
  address        String   @db.Text
  accreditation  String?
  contactPerson  String?  @map("contact_person")
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  departments    String[] // Postgres ARRAY of department names
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  doctors      Doctor[]
  appointments Appointment[]

  @@index([city])
  @@index([isActive])
  @@map("hospitals")
}

model Doctor {
  id               String   @id @default(cuid())
  hospitalId       String   @map("hospital_id")
  fullName         String   @map("full_name")
  specialisationId String   @map("specialisation_id")
  qualification    String?
  languages        String[] // Postgres ARRAY
  consultationFee  Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  availableDays    String[] @map("available_days") // e.g. ["MON","TUE","WED"]
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  hospital       Hospital       @relation(fields: [hospitalId], references: [id])
  specialisation Specialisation @relation(fields: [specialisationId], references: [id])
  appointments   Appointment[]

  @@index([hospitalId])
  @@index([specialisationId])
  @@map("doctors")
}

model Hostel {
  id              String   @id @default(cuid())
  name            String
  city            String
  address         String   @db.Text
  capacity        Int
  pricingPerNight Decimal  @map("pricing_per_night") @db.Decimal(10, 2)
  roomTypes       String[] @map("room_types")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  accommodationBookings AccommodationBooking[]

  @@index([city])
  @@map("hostels")
}

model Appointment {
  id                 String            @id @default(cuid())
  caseId             String            @map("case_id")
  patientId          String            @map("patient_id")
  hospitalId         String            @map("hospital_id")
  doctorId           String            @map("doctor_id")
  appointmentType    AppointmentType   @map("appointment_type")
  scheduledAt        DateTime          @map("scheduled_at")
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?           @map("cancellation_reason")
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relations
  case     Case     @relation(fields: [caseId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  creator  User     @relation("CreatedAppointments", fields: [createdBy], references: [id])

  @@index([caseId])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model AccommodationBooking {
  id        String              @id @default(cuid())
  caseId    String              @map("case_id")
  hostelId  String              @map("hostel_id")
  checkIn   DateTime            @map("check_in")
  checkOut  DateTime            @map("check_out")
  roomType  RoomType            @map("room_type")
  status    AccommodationStatus @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  // Relations
  case   Case   @relation(fields: [caseId], references: [id])
  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([caseId])
  @@index([hostelId])
  @@map("accommodation_bookings")
}

model Document {
  id         String           @id @default(cuid())
  patientId  String           @map("patient_id")
  uploadedBy String           @map("uploaded_by")
  category   DocumentCategory
  fileUrl    String           @map("file_url")
  fileName   String           @map("file_name")
  fileSize   Int              @map("file_size") // bytes
  mimeType   String?          @map("mime_type")
  createdAt  DateTime         @default(now()) @map("created_at")

  // Relations
  patient  Patient @relation(fields: [patientId], references: [id])
  uploader User    @relation("UploadedDocuments", fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@index([category])
  @@map("documents")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  channel      NotificationChannel
  title        String
  body         String              @db.Text
  isRead       Boolean             @default(false) @map("is_read")
  sentAt       DateTime            @default(now()) @map("sent_at")
  triggerEvent String?             @map("trigger_event")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  subject    String?
  body       String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("messages")
}
